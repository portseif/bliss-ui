    "It stops at the next safe step. Anything already done stays in place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufgabe stoppt beim nächsten sicheren Schritt. Bereits Erledigtes bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarea se detiene en el siguiente paso seguro. Lo que ya se hizo se queda como está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tâche s'arrête à la prochaine étape sûre. Tout ce qui est déjà fait reste en place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'attività si ferma al prossimo passaggio sicuro. Ciò che è già stato fatto resta com'è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の安全なステップで停止します。すでに完了したものはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 안전한 단계에서 중지됩니다. 이미 완료된 항목은 그대로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tarefa para na próxima etapa segura. O que já foi feito continua no lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
